# Required
DATABASE_URL=postgresql://user:password@host:5432/perfusion
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (file uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily.co (video rooms)
DAILY_API_KEY=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend (transactional email)
RESEND_API_KEY=

# Web Push / VAPID (PWA push notifications)
VAPID_PRIVATE_KEY=

# Exotel (masked phone call bridging — consultation call buttons)
# Sign up at https://exotel.com and create a virtual number.
# Without these four vars the call buttons gracefully return HTTP 503.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=
