{
  "expo": {
    "name": "Perfusion",
    "slug": "perfusion-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perfusion-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.perfusion.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Perfusion uses the camera for secure video consultations and clinical file capture.",
        "NSMicrophoneUsageDescription": "Perfusion uses the microphone for secure voice and video consultations.",
        "NSUserNotificationsUsageDescription": "Perfusion sends consultation, Case File, and call notifications."
      }
    },
    "android": {
      "package": "com.perfusion.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F7F9"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#DB2841"
        }
      ],
      "@stream-io/video-react-native-sdk",
      "./plugins/withCallPiP",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Perfusion uses the camera for secure video consultations.",
          "microphonePermission": "Perfusion uses the microphone for secure voice and video consultations."
        }
      ],
      [
        "./plugins/withSafeCallKit",
        {
          "incomingCallTimeout": 45,
          "fulfillAnswerCallTimeout": 30,
          "includesCallsInRecents": false,
          "sounds": [
            "./assets/audio/perfusion_ring.wav"
          ],
          "defaultRingtoneIos": "default",
          "defaultRingtoneAndroid": "default",
          "microphonePermission": "Perfusion uses the microphone for secure voice and video consultations.",
          "cameraPermission": "Perfusion uses the camera for secure video consultations."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "perfusion",
    "extra": {
      "eas": {
        "projectId": "152f3e2b-ef3c-485d-b808-6d017eb2f925"
      }
    }
  }
}
